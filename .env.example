# Environment Configuration for Sony Camera Ingestion
# Copy this file to .env and adjust values for your environment.

# Storage Paths
NAS_STORAGE_DIR=/Volumes/Club S/NAS_Photo_Hub

# Network Configuration
FTP_HOST=0.0.0.0
FTP_PORT=2121

# Credentials
FTP_INGEST_USER=sony
FTP_INGEST_PASSWORD=CHANGE_ME_IN_ENV

FTP_ADMIN_USER=clubs
FTP_ADMIN_PASSWORD=CHANGE_ME_IN_ENV
